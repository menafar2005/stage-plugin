{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stage-plugin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stage-plugin-db",
      "database_id": "3a281721-2d40-4722-ac2a-9feca8f9f4a7",
      "migrations_dir": "migrations"
    }
  ],

  // Daily cleanup of ended/expired runtime sessions (by absolute session end), old rate-limit windows and API logs
  "triggers": { "crons": ["0 3 * * *"] },

  // No "vars" and no secrets on purpose: every setting lives in the project (see README "Run / deploy").
  //   src/config.ts  (committed):   DIDAR_ORIGIN, DIDAR_APP_URL, MARKETPLACE_URL, RATE_LIMIT_PER_MINUTE, DIDAR_REDIRECT_URI
  //   src/secrets.ts (git-ignored): DIDAR_CLIENT_ID, DIDAR_CLIENT_SECRET, ENCRYPTION_KEY, DIDAR_INSTALLATION_URL
  //   No OpenAPI key anywhere: each BizDomain's api_key is read from installations.api_key_encrypted in D1.
  // Without "vars" (and without keep_vars), a deploy removes any plain variable set in the dashboard.
}
