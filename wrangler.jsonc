{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stage-plugin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Runs before bundling on every deploy/dev: creates an empty src/secrets.ts when it is missing (Cloudflare's Git
  // build), so the build never fails on it; locally it keeps your existing file (see scripts/write-secrets.mjs).
  "build": { "command": "node scripts/write-secrets.mjs", "watch_dir": "scripts" },

  // Keep the variables set in the dashboard (Settings -> Variables and Secrets) on every deploy.
  // Without this, a deploy from this file (which declares no "vars") would delete them.
  "keep_vars": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stage-plugin-db",
      "database_id": "3a281721-2d40-4722-ac2a-9feca8f9f4a7",
      "migrations_dir": "migrations"
    }
  ],

  // Daily cleanup of ended/expired runtime sessions (by absolute session end), old rate-limit windows and API logs
  "triggers": { "crons": ["0 3 * * *"] },

  // Where settings live (see README "Run / deploy"):
  //   src/config.ts (committed): DIDAR_ORIGIN, DIDAR_APP_URL, MARKETPLACE_URL, RATE_LIMIT_PER_MINUTE, DIDAR_REDIRECT_URI.
  //     Same-named Cloudflare variables are ignored for these.
  //   Worker variables/secrets in the dashboard: DIDAR_CLIENT_ID, DIDAR_CLIENT_SECRET, ENCRYPTION_KEY, DIDAR_INSTALLATION_URL.
  //     src/secrets.ts (git-ignored) is only a local fallback for them.
  //   No OpenAPI key anywhere: each BizDomain's api_key is read from installations.api_key_encrypted in D1.
}
