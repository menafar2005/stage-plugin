{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stage-plugin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stage-plugin-db",
      "database_id": "3a281721-2d40-4722-ac2a-9feca8f9f4a7",
      "migrations_dir": "migrations"
    }
  ],

  // Daily cleanup of ended/expired runtime sessions (by absolute session end), old rate-limit windows and API logs
  "triggers": { "crons": ["0 3 * * *"] },

  "vars": {
    "DIDAR_ORIGIN": "https://app.didar.me",
    "DIDAR_APP_URL": "https://app.didar.me",
    "MARKETPLACE_URL": "https://marketplace.didar.me",
    "RATE_LIMIT_PER_MINUTE": "120"
  }

  // Secrets (wrangler secret put <NAME>; locally in .dev.vars):
  //   DIDAR_CLIENT_ID, DIDAR_CLIENT_SECRET, ENCRYPTION_KEY, DIDAR_INSTALLATION_URL,
  //   DIDAR_REDIRECT_URI (exact Callback URL registered in Developer Hub: BASE/didar/callback),
  //   DIDAR_API_KEY (Didar OpenAPI key; add it as a Secret, not a plaintext variable: deploys overwrite plaintext vars)
}
