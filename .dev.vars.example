# Copy to .dev.vars for `wrangler dev`. In production use `wrangler secret put <NAME>`.
# From Developer Hub -> OAuth & access scopes
DIDAR_CLIENT_ID=
DIDAR_CLIENT_SECRET=
# Developer Hub -> Share install link (used by /didar/install to add a one-time state)
DIDAR_INSTALLATION_URL=
# Exactly the Callback URL registered in Developer Hub; sent as redirect_uri to /install/auth/token
# Production (stage-plugin Worker): https://stage-plugin.ehsan2005-ir.workers.dev/didar/callback  (local: http://localhost:8787/didar/callback)
DIDAR_REDIRECT_URI=
# Didar OpenAPI key (Didar -> Settings -> Connect to other servers -> Connect to Didar). Sent as ?apikey= to app.didar.me
DIDAR_API_KEY=
# 32 random bytes, base64. Encrypts the installation api_key and the Runtime access/refresh tokens (AES-GCM).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
